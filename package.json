{
  "name": "grab",
  "productName": "Grab",
  "version": "1.0.0",
  "description": "Circle anything on screen and ask Claude about it.",
  "main": "src/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && electron .",
    "dist": "node scripts/build.js && electron-builder --win nsis"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "app.grab.desktop",
    "productName": "Grab",
    "files": ["src/**/*", "!src/vendor-entry.js", "package.json"],
    "asarUnpack": ["src/native/**"],
    "directories": { "buildResources": "build" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "createDesktopShortcut": false, "createStartMenuShortcut": true },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" }
  }
}
